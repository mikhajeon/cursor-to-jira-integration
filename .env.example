# Jira API — copy this file to .env and fill in your values.
# .env is gitignored; never commit real tokens.
#
# Replace the placeholders below:
#   jiraorgname             → your Jira org name (e.g. yourcompany for yourcompany.atlassian.net)
#   email.address@domainname.com → your Atlassian account email

JIRA_DOMAIN=jiraorgname
JIRA_EMAIL=email.address@domainname.com
JIRA_API_TOKEN=paste-your-token-here
# Optional: for sprint board & backlog (PM workspace). If unset, script uses first board for project DPH.
# JIRA_BOARD_ID=123
